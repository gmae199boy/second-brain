{
  "name": "second-brain-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "second-brain": "tooling/bootstrap/bin/second-brain.js"
  },
  "files": [
    "tooling/bootstrap/bin/second-brain.js"
  ],
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm build && pnpm typecheck && vitest run",
    "brain": "node apps/cli/dist/bin.js",
    "test:python": "pnpm build && vitest run --config apps/cli/python-test/vitest.config.ts",
    "eval:install": "node tooling/install-eval/eval.mjs",
    "eval:channels": "node tooling/channels-eval/eval.mjs",
    "test:changed": "node tooling/test-changed/run.mjs",
    "eval:recall": "node tooling/recall-eval/eval.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "ajv": "^8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
