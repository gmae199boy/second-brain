# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
# The install entry point is built into `bin/` and committed, but tsc's own
# output name is not the committed one: an interrupted `tsc && mv` build would
# otherwise leave an untracked file that makes the clone look locally changed.
tooling/bootstrap/bin/bootstrap.js
dist/
build/
out/
lib-cov/
*.tsbuildinfo
.turbo/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage
coverage/
.nyc_output/
junit.xml

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Package manager
.npm/
.pnpm-store/
*.tgz

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Local databases and data
*.sqlite
*.sqlite3
*.db
data/
pgdata/

# Claude Code local settings
.claude/settings.local.json

# BMad personal overrides (also ignored by _bmad/custom/.gitignore)
_bmad/custom/*.user.toml

# Tool caches
.codegraph/
graphify-out/

# BMad rendered skill snapshots (regenerated on each run)
_bmad/render/
.bmad-loop/runs/
.bmad-loop/cache/
# policy.toml is tracked on purpose; the line only stops `bmad-loop init` from
# appending it again. Ignoring a tracked file does not untrack it.
.bmad-loop/policy.toml
# bmad-loop hooks: bmad-loop only accepts its own absolute path here, which
# carries the home folder. Recreate them on each machine with `bmad-loop init`
# (it registers claude and codex, the CLIs .bmad-loop/policy.toml names).
.claude/settings.json
.codex/hooks.json
