{
  "name": "garmin",
  "version": "1.2.0",
  "core": 1,
  "abi": 1,
  "migrations": "migrations",
  "connection_check": {
    "runtime": "python",
    "entry": "src/check.py"
  },
  "work": [
    {
      "kind": "garmin.import",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/import.py",
      "required_settings": [
        "garmin.capture_manifest",
        "garmin.timezone"
      ],
      "manual": "import"
    },
    {
      "kind": "garmin.import_preflight",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/import_preflight.py",
      "manual": "import-preflight",
      "required_settings": [
        "garmin.capture_manifest"
      ],
      "public_report": {
        "counts": [
          "datasets",
          "tables",
          "rows",
          "conflict_keys",
          "raw_conflict_keys",
          "raw_metadata_conflict_keys",
          "unselected_keys",
          "excluded_keys",
          "unconfirmed_accounts",
          "previous_batches",
          "expected_file_requests",
          "exclusion_reasons",
          "activity_rows",
          "activity_overlap",
          "activity_only",
          "activity_conflicts",
          "activity_hr_sample_rows",
          "activity_hr_sample_overlap",
          "activity_hr_sample_only",
          "activity_hr_sample_conflicts",
          "activity_recovery_rows",
          "activity_recovery_overlap",
          "activity_recovery_only",
          "activity_recovery_conflicts",
          "auth_event_rows",
          "auth_event_overlap",
          "auth_event_only",
          "auth_event_conflicts",
          "body_battery_sample_rows",
          "body_battery_sample_overlap",
          "body_battery_sample_only",
          "body_battery_sample_conflicts",
          "daily_metric_rows",
          "daily_metric_overlap",
          "daily_metric_only",
          "daily_metric_conflicts",
          "day_summary_rows",
          "day_summary_overlap",
          "day_summary_only",
          "day_summary_conflicts",
          "delivery_rows",
          "delivery_overlap",
          "delivery_only",
          "delivery_conflicts",
          "evaluation_rows",
          "evaluation_overlap",
          "evaluation_only",
          "evaluation_conflicts",
          "exercise_log_rows",
          "exercise_log_overlap",
          "exercise_log_only",
          "exercise_log_conflicts",
          "exercise_set_rows",
          "exercise_set_overlap",
          "exercise_set_only",
          "exercise_set_conflicts",
          "fetch_error_rows",
          "fetch_error_overlap",
          "fetch_error_only",
          "fetch_error_conflicts",
          "hr_sample_rows",
          "hr_sample_overlap",
          "hr_sample_only",
          "hr_sample_conflicts",
          "meta_rows",
          "meta_overlap",
          "meta_only",
          "meta_conflicts",
          "normalize_result_rows",
          "normalize_result_overlap",
          "normalize_result_only",
          "normalize_result_conflicts",
          "notification_rows",
          "notification_overlap",
          "notification_only",
          "notification_conflicts",
          "raw_response_rows",
          "raw_response_overlap",
          "raw_response_only",
          "raw_response_conflicts",
          "run_rows",
          "run_overlap",
          "run_only",
          "run_conflicts",
          "stress_bb_sample_rows",
          "stress_bb_sample_overlap",
          "stress_bb_sample_only",
          "stress_bb_sample_conflicts",
          "workout_rows",
          "workout_overlap",
          "workout_only",
          "workout_conflicts",
          "expected_preservation_candidates",
          "expected_dataset_candidates",
          "expected_mapping_candidates"
        ],
        "checks": [
          "core_ready",
          "extension_ready",
          "abi_ready",
          "role_ready",
          "attempt_current",
          "source_unchanged",
          "total_insert_known"
        ]
      }
    },
    {
      "kind": "garmin.import_verify",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/import_verify.py",
      "manual": "import-verify",
      "required_settings": [
        "garmin.capture_manifest",
        "garmin.timezone"
      ],
      "public_report": {
        "counts": [
          "datasets",
          "source_tables",
          "source_rows",
          "preserved_rows",
          "raw_rows",
          "file_requests",
          "conflict_entries",
          "mismatches"
        ],
        "checks": [
          "source_unchanged",
          "checkpoints",
          "schemas",
          "preserved",
          "mappings",
          "raw",
          "legacy",
          "files",
          "inventory",
          "conflicts"
        ]
      }
    },
    {
      "kind": "garmin.collect",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/collect.py",
      "manual": "collect",
      "required_settings": [
        "garmin.timezone",
        "garmin.tokenstore"
      ]
    },
    {
      "kind": "garmin.report",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/report.py",
      "manual": "report",
      "required_settings": [
        "garmin.timezone",
        "garmin.analysis_model"
      ]
    },
    {
      "kind": "garmin.report_regenerate",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/report.py",
      "manual": "report-regenerate",
      "required_settings": [
        "garmin.timezone",
        "garmin.analysis_model"
      ]
    }
  ],
  "settings": [
    {
      "key": "garmin.capture_manifest",
      "type": "string",
      "required": []
    },
    {
      "key": "garmin.legacy_conversation_id",
      "type": "string",
      "required": []
    },
    {
      "key": "garmin.timezone",
      "type": "string",
      "scope": "user",
      "required": []
    },
    {
      "key": "garmin.tokenstore",
      "type": "string",
      "machine": "tokenstore",
      "required": []
    },
    {
      "key": "garmin.analysis_agent",
      "type": "string",
      "required": [],
      "default": "codex"
    },
    {
      "key": "garmin.analysis_model",
      "type": "string",
      "required": []
    },
    {
      "key": "garmin.analysis_reasoning_effort",
      "type": "string",
      "required": [],
      "default": "high"
    },
    {
      "key": "garmin.analysis_timeout_minutes",
      "type": "number",
      "required": [],
      "default": "20"
    }
  ],
  "error_codes": [
    "IMPORT_CONFLICT",
    "IMPORT_INVALID",
    "PREFLIGHT_INVALID",
    "PREFLIGHT_SCHEMA_UNSUPPORTED",
    "EXTENSION_REPORT_NOT_READY",
    "PREFLIGHT_STALE",
    "IMPORT_FILES_PENDING",
    "IMPORT_FILES_FAILED",
    "COLLECT_INVALID",
    "COLLECT_LOCKED",
    "COLLECT_UNAVAILABLE",
    "REPORT_INVALID",
    "REPORT_STALE",
    "REPORT_LOCKED",
    "REPORT_FAILED",
    "REPORT_UNAVAILABLE"
  ]
}
