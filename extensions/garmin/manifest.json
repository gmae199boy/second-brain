{
  "name": "garmin",
  "version": "1.2.5",
  "core": 1,
  "abi": 1,
  "migrations": "migrations",
  "connection_check": {
    "runtime": "python",
    "entry": "src/check.py"
  },
  "work": [
    {
      "kind": "garmin.import",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/import.py",
      "required_settings": [
        "garmin.capture_manifest",
        "garmin.timezone"
      ],
      "manual": "import"
    },
    {
      "kind": "garmin.import_preflight",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/import_preflight.py",
      "manual": "import-preflight",
      "required_settings": [
        "garmin.capture_manifest"
      ],
      "public_report": {
        "counts": [
          "datasets",
          "tables",
          "rows",
          "conflict_keys",
          "raw_conflict_keys",
          "raw_metadata_conflict_keys",
          "unselected_keys",
          "excluded_keys",
          "unconfirmed_accounts",
          "previous_batches",
          "expected_file_requests",
          "exclusion_reasons",
          "activity_rows",
          "activity_overlap",
          "activity_only",
          "activity_conflicts",
          "activity_hr_sample_rows",
          "activity_hr_sample_overlap",
          "activity_hr_sample_only",
          "activity_hr_sample_conflicts",
          "activity_recovery_rows",
          "activity_recovery_overlap",
          "activity_recovery_only",
          "activity_recovery_conflicts",
          "auth_event_rows",
          "auth_event_overlap",
          "auth_event_only",
          "auth_event_conflicts",
          "body_battery_sample_rows",
          "body_battery_sample_overlap",
          "body_battery_sample_only",
          "body_battery_sample_conflicts",
          "daily_metric_rows",
          "daily_metric_overlap",
          "daily_metric_only",
          "daily_metric_conflicts",
          "day_summary_rows",
          "day_summary_overlap",
          "day_summary_only",
          "day_summary_conflicts",
          "delivery_rows",
          "delivery_overlap",
          "delivery_only",
          "delivery_conflicts",
          "evaluation_rows",
          "evaluation_overlap",
          "evaluation_only",
          "evaluation_conflicts",
          "exercise_log_rows",
          "exercise_log_overlap",
          "exercise_log_only",
          "exercise_log_conflicts",
          "exercise_set_rows",
          "exercise_set_overlap",
          "exercise_set_only",
          "exercise_set_conflicts",
          "fetch_error_rows",
          "fetch_error_overlap",
          "fetch_error_only",
          "fetch_error_conflicts",
          "hr_sample_rows",
          "hr_sample_overlap",
          "hr_sample_only",
          "hr_sample_conflicts",
          "meta_rows",
          "meta_overlap",
          "meta_only",
          "meta_conflicts",
          "normalize_result_rows",
          "normalize_result_overlap",
          "normalize_result_only",
          "normalize_result_conflicts",
          "notification_rows",
          "notification_overlap",
          "notification_only",
          "notification_conflicts",
          "raw_response_rows",
          "raw_response_overlap",
          "raw_response_only",
          "raw_response_conflicts",
          "run_rows",
          "run_overlap",
          "run_only",
          "run_conflicts",
          "stress_bb_sample_rows",
          "stress_bb_sample_overlap",
          "stress_bb_sample_only",
          "stress_bb_sample_conflicts",
          "workout_rows",
          "workout_overlap",
          "workout_only",
          "workout_conflicts",
          "expected_preservation_candidates",
          "expected_dataset_candidates",
          "expected_mapping_candidates"
        ],
        "checks": [
          "core_ready",
          "extension_ready",
          "abi_ready",
          "role_ready",
          "attempt_current",
          "source_unchanged",
          "total_insert_known"
        ]
      }
    },
    {
      "kind": "garmin.import_verify",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/import_verify.py",
      "manual": "import-verify",
      "required_settings": [
        "garmin.capture_manifest",
        "garmin.timezone"
      ],
      "public_report": {
        "counts": [
          "datasets",
          "source_tables",
          "source_rows",
          "preserved_rows",
          "raw_rows",
          "file_requests",
          "conflict_entries",
          "mismatches"
        ],
        "checks": [
          "source_unchanged",
          "checkpoints",
          "schemas",
          "preserved",
          "mappings",
          "raw",
          "legacy",
          "files",
          "inventory",
          "conflicts"
        ]
      }
    },
    {
      "kind": "garmin.collect",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/collect.py",
      "manual": "collect",
      "required_settings": [
        "garmin.timezone",
        "garmin.tokenstore"
      ],
      "missed": "latest"
    },
    {
      "kind": "garmin.report",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/report.py",
      "manual": "report",
      "required_settings": [
        "garmin.timezone",
        "garmin.analysis_model"
      ],
      "missed": "latest"
    },
    {
      "kind": "garmin.report_regenerate",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/report.py",
      "manual": "report-regenerate",
      "required_settings": [
        "garmin.timezone",
        "garmin.analysis_model"
      ]
    },
    {
      "kind": "garmin.report_send",
      "execution": "supervised",
      "runtime": "python",
      "entry": "src/report.py",
      "manual": "report-send",
      "required_settings": [
        "garmin.timezone",
        "garmin.connection_id"
      ]
    }
  ],
  "settings": [
    {
      "key": "garmin.capture_manifest",
      "type": "string",
      "required": []
    },
    {
      "key": "garmin.legacy_conversation_id",
      "type": "string",
      "required": []
    },
    {
      "key": "garmin.timezone",
      "type": "string",
      "scope": "user",
      "required": []
    },
    {
      "key": "garmin.tokenstore",
      "type": "string",
      "machine": "tokenstore",
      "required": []
    },
    {
      "key": "garmin.analysis_agent",
      "type": "string",
      "required": [],
      "default": "codex"
    },
    {
      "key": "garmin.analysis_model",
      "type": "string",
      "required": []
    },
    {
      "key": "garmin.analysis_reasoning_effort",
      "type": "string",
      "required": [],
      "default": "high"
    },
    {
      "key": "garmin.analysis_timeout_minutes",
      "type": "number",
      "required": [],
      "default": "20"
    },
    {
      "key": "garmin.connection_id",
      "type": "string",
      "scope": "user",
      "required": []
    },
    {
      "key": "garmin.channel_conversation_id",
      "type": "string",
      "scope": "user",
      "required": []
    }
  ],
  "error_codes": [
    "IMPORT_CONFLICT",
    "IMPORT_INVALID",
    "PREFLIGHT_INVALID",
    "PREFLIGHT_SCHEMA_UNSUPPORTED",
    "EXTENSION_REPORT_NOT_READY",
    "PREFLIGHT_STALE",
    "IMPORT_FILES_PENDING",
    "IMPORT_FILES_FAILED",
    "COLLECT_INVALID",
    "COLLECT_LOCKED",
    "COLLECT_UNAVAILABLE",
    "REPORT_INVALID",
    "REPORT_STALE",
    "REPORT_LOCKED",
    "REPORT_FAILED",
    "REPORT_UNAVAILABLE",
    "COLLECT_INCOMPLETE"
  ],
  "commands": [
    {
      "name": "daily-values",
      "runtime": "python",
      "entry": "src/query_daily_values.py",
      "description": "Garmin daily-values 조회",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "start_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "metric": {
            "type": "string",
            "enum": [
              "sleep_total_s",
              "sleep_deep_s",
              "sleep_light_s",
              "sleep_rem_s",
              "sleep_awake_s",
              "sleep_score",
              "sleep_hr_min",
              "hrv_avg",
              "spo2_avg",
              "spo2_min",
              "resp_avg",
              "wake_bb",
              "bb_high",
              "bb_low",
              "bb_charged",
              "bb_drained",
              "stress_avg",
              "stress_high_s",
              "steps",
              "active_kcal",
              "moderate_min",
              "vigorous_min",
              "resting_hr",
              "weight_kg",
              "workout.duration_s",
              "workout.hr_avg",
              "workout.hr_max",
              "workout.zone1_s",
              "workout.zone2_s",
              "workout.zone3_s",
              "workout.zone4_s",
              "workout.zone5_s",
              "workout.bb_change",
              "exercise.sets",
              "exercise.reps",
              "exercise.max_kg",
              "exercise.volume_kg",
              "exercise.set_peak_hr_avg",
              "exercise.rest_drop_avg",
              "set.reps",
              "set.weight_g",
              "set.duration_s"
            ]
          },
          "activity_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "exercise": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "connection_id",
          "timezone",
          "start_date",
          "end_date",
          "metric"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "date",
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false
      },
      "timeout_ms": 15000,
      "risk": "read"
    },
    {
      "name": "period-summary",
      "runtime": "python",
      "entry": "src/query_period_summary.py",
      "description": "Garmin period-summary 조회",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "start_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "metric": {
            "type": "string",
            "enum": [
              "sleep_total_s",
              "sleep_deep_s",
              "sleep_light_s",
              "sleep_rem_s",
              "sleep_awake_s",
              "sleep_score",
              "sleep_hr_min",
              "hrv_avg",
              "spo2_avg",
              "spo2_min",
              "resp_avg",
              "wake_bb",
              "bb_high",
              "bb_low",
              "bb_charged",
              "bb_drained",
              "stress_avg",
              "stress_high_s",
              "steps",
              "active_kcal",
              "moderate_min",
              "vigorous_min",
              "resting_hr",
              "weight_kg",
              "workout.duration_s",
              "workout.hr_avg",
              "workout.hr_max",
              "workout.zone1_s",
              "workout.zone2_s",
              "workout.zone3_s",
              "workout.zone4_s",
              "workout.zone5_s",
              "workout.bb_change",
              "exercise.sets",
              "exercise.reps",
              "exercise.max_kg",
              "exercise.volume_kg",
              "exercise.set_peak_hr_avg",
              "exercise.rest_drop_avg",
              "set.reps",
              "set.weight_g",
              "set.duration_s"
            ]
          },
          "activity_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "exercise": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "aggregation": {
            "type": "string",
            "enum": [
              "sum",
              "mean"
            ]
          }
        },
        "required": [
          "connection_id",
          "timezone",
          "start_date",
          "end_date",
          "metric",
          "aggregation"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "observed_count": {
            "type": "integer",
            "minimum": 0
          },
          "null_count": {
            "type": "integer",
            "minimum": 0
          },
          "start_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "value",
          "unit",
          "observed_count",
          "null_count",
          "start_date",
          "end_date"
        ],
        "additionalProperties": false
      },
      "timeout_ms": 15000,
      "risk": "read"
    },
    {
      "name": "recent-evaluations",
      "runtime": "python",
      "entry": "src/query_recent_evaluations.py",
      "description": "Garmin recent-evaluations 조회",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "scope": {
            "type": "string",
            "enum": [
              "day",
              "7d",
              "30d",
              "all"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "connection_id",
          "timezone",
          "scope",
          "limit"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "evaluations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "day",
                    "7d",
                    "30d",
                    "all"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "file_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "date",
                "scope",
                "summary",
                "file_id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "evaluations"
        ],
        "additionalProperties": false
      },
      "timeout_ms": 15000,
      "risk": "read"
    }
  ],
  "requires": [
    "channel.send"
  ],
  "default_schedules": [
    {
      "key": "collect",
      "kind": "garmin.collect",
      "target_kind": "extension",
      "target_id": "unselected",
      "target_setting": "garmin.connection_id",
      "cron": "0 11 * * *",
      "time_zone": "Asia/Seoul"
    },
    {
      "key": "report",
      "kind": "garmin.report",
      "target_kind": "extension",
      "target_id": "unselected",
      "target_setting": "garmin.connection_id",
      "cron": "30 11 * * *",
      "time_zone": "Asia/Seoul",
      "after_schedule": "collect"
    }
  ]
}
