{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "report_md": {
      "type": "string"
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 2
        },
        "trend_line": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "headline",
        "recommendations",
        "trend_line",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "summary",
    "report_md",
    "judgments",
    "evidence",
    "next_checks",
    "message"
  ],
  "additionalProperties": false
}
