#!/bin/sh
# Refuse a commit message that carries this machine's home folder path.
. "$(dirname "$0")/home-path-pattern.sh"

found=$(grep -v '^#' "$1" | grep -E -- "$home_path_pattern")

if [ -n "$found" ]; then
  echo "커밋 거부: 커밋 메시지에 $home_path_hint" >&2
  printf '%s\n' "$found" | cut -c1-200 >&2
  exit 1
fi
