[
  {
    "name": "minimal",
    "manifest": {
      "name": "testext",
      "version": "1.0",
      "core": 1,
      "abi": 1,
      "migrations": "migrations",
      "connection_check": {
        "runtime": "node",
        "entry": "check.mjs"
      }
    },
    "expect": "valid"
  },
  {
    "name": "settings",
    "manifest": {
      "name": "testext",
      "version": "1.0",
      "core": 1,
      "abi": 1,
      "migrations": "migrations",
      "connection_check": {
        "runtime": "node",
        "entry": "check.mjs"
      },
      "settings": [
        {
          "key": "testext.token",
          "type": "string",
          "secret": true,
          "required": [
            "work"
          ]
        },
        {
          "key": "testext.limit",
          "type": "number",
          "default": "10",
          "required": [
            "connect"
          ]
        }
      ]
    },
    "expect": "valid"
  },
  {
