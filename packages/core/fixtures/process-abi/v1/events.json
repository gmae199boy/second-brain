    "expect": "valid"
  },
  {
    "name": "zero usage",
    "line": "{\"abi\": 1, \"type\": \"result\", \"usage\": {\"input_tokens\": 0, \"cached_input_tokens\": 0, \"output_tokens\": 0}}",
