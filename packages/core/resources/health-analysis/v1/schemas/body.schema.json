{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "garmin-pipeline 체성분 사이드카",
  "description": "data/body/<measured_on>.json의 계약(FR23·24·25, AD-9). 루트는 측정일 하나의 사이드카이고, `body write`가 stdin으로 받는 측정 1건은 $defs/measurement다. 키 순서는 body.py가 고정한다(values·value_mtime_ns는 $defs/measurement.properties 순서). 측정 키 집합과 단위는 잠정이다(첫 실제 인바디 스크린샷을 보고 사람이 정한다). 바꿀 때는 $defs/measurement.properties와 $defs/measurement_key를 함께 고친다(테스트가 같은지 확인한다).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measured_on",
    "values",
    "value_mtime_ns",
    "source_files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "measured_on": {
      "description": "측정일(config timezone 기준 로컬 날짜).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "values": { "$ref": "#/$defs/measurement" },
    "value_mtime_ns": {
      "description": "values의 키별로 그 값을 준 입력 파일의 mtime(ns). 키 집합은 values와 같다.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/measurement_key" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "source_files": {
      "description": "지금까지 이 측정일에 반영한 입력 파일(운영 루트 기준 상대 POSIX 경로, 받은 순서).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "measurement_key": {
      "description": "$defs/measurement.properties의 키와 같다.",
      "enum": [
        "weight_kg",
        "skeletal_muscle_mass_kg",
        "body_fat_mass_kg",
        "body_fat_percent",
        "bmi",
        "total_body_water_l",
        "protein_kg",
        "minerals_kg",
        "basal_metabolic_rate_kcal",
        "visceral_fat_level",
        "inbody_score"
      ]
    },
    "measurement": {
      "description": "측정 1건(body write stdin). 모든 키가 선택이고 하나 이상 있어야 한다.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "weight_kg": {
          "description": "체중(kg).",
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "skeletal_muscle_mass_kg": {
          "description": "골격근량(kg).",
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "body_fat_mass_kg": {
          "description": "체지방량(kg).",
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "body_fat_percent": {
          "description": "체지방률(%).",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "bmi": {
          "description": "BMI(kg/m²).",
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "total_body_water_l": {
          "description": "체수분(L).",
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "protein_kg": {
          "description": "단백질(kg).",
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "minerals_kg": {
          "description": "무기질(kg).",
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "basal_metabolic_rate_kcal": {
          "description": "기초대사량(kcal).",
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "visceral_fat_level": {
          "description": "내장지방 레벨.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "inbody_score": {
          "description": "인바디 점수.",
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      }
    }
  }
}
