{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "abi",
        "type"
      ],
      "properties": {
        "abi": {
          "const": 1
        },
        "type": {
          "const": "progress"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "abi",
        "type"
      ],
      "properties": {
        "abi": {
          "const": 1
        },
        "type": {
          "const": "heartbeat"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "abi",
        "type"
      ],
      "properties": {
        "abi": {
          "const": 1
        },
        "type": {
          "const": "result"
        },
        "summary": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "required": [
            "input_tokens",
            "cached_input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "abi",
        "type",
        "code",
        "retryable"
      ],
      "properties": {
        "abi": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
