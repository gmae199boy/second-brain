{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "extension",
    "user_id",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "extension": {
      "type": "string",
      "pattern": "^(?!(?:core|brain|public|pg_))[a-z][a-z0-9_]{0,30}$"
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
